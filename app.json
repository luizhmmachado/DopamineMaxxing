{
  "expo": {
    "name": "DopamineMaxxing",
    "slug": "dopamine-maxxing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dopaminemaxxing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dopaminemaxxing.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O DopamineMaxxing acessa sua galeria apenas para você escolher uma foto de perfil.",
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização somente se você consentir, para personalizar seu perfil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dopaminemaxxing.app",
      "adaptiveIcon": {
        "backgroundColor": "#08080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O DopamineMaxxing acessa sua galeria apenas para você escolher uma foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização somente se você consentir, para personalizar seu perfil."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "O DopamineMaxxing usa o armazenamento seguro do dispositivo para proteger sua sessão."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "38251618-c2a8-45b0-a2c5-3784f95dacb3"
      }
    },
    "owner": "bdway"
  }
}
